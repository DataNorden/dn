            "skipDirpaths": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "title": "-P, --skip-dirpaths <search...>",
              "description": "skipDirpaths: "
            },
            "skipDirnames": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "title": "-N, --skip-dirnames <search...>",
              "description": "skipDirnames: "
            },
            "maxResults": {
              "type": "string",
              "title": "-m, --max-results <int>",
              "description": "maxResults: "
            },
            "maxSize": {
              "type": "string",
              "title": "-s, --max-size <kB>",
              "description": "maxSize: "
            },
            "outfile": {
              "type": "string",
              "title": "-o, --outfile <path>",
              "description": "outfile: "
            },
            "ignoreCase": {
              "type": "string",
              "title": "-I, --no-ignore-case",
              "description": "ignoreCase: "
            },
            "logLevel": {
              "type": "string",
              "title": "-L, --log-level <level>",
              "description": "logLevel: "
            },
            "silent": {
              "type": "boolean",
              "title": "-S, --silent",
              "description": "silent: "
            },
            "debug": {
              "type": "boolean",
              "title": "-D, --debug",
              "description": "debug: "
            },
            "writePreset": {
              "type": "string",
              "title": "-W, --write-preset <name>",
              "description": "writePreset: "
            }
          }
        },
        "globalOptions": {
          "$id": "GlobalUserOptions",
          "default": {},
          "type": "object",
          "properties": {
            "usePresets": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "logLevel": {
              "anyOf": [
                {
                  "const": "silent",
                  "type": "string"
                },
                {
                  "const": "error",
                  "type": "string"
                },
                {
                  "const": "data",
                  "type": "string"
                },
                {
                  "const": "info",
                  "type": "string"
                },
                {
                  "const": "debug",
                  "type": "string"
                }
              ]
            },
            "editorStart": {
              "title": "Launch new text editor",
              "description": "Shell command that starts the preferred text editor. It is expected that its first argument can be a filepath like most editors.",
              "type": "string"
            },
            "editorEdit": {
              "title": "Edit in text editor",
              "description": "Shell command that starts the preferred text editor so that the shell will wait for the editor process to terminate. Used when command-line opens something in editor and waits for user. It is expected that its first argument can be a filepath like most editors.",
              "type": "string"
            }
          },
          "required": ["logLevel"]
        }
      },
      "required": ["args", "options", "globalOptions"]
    },
