{
  "$id": "Config",
  "type": "object",
  "definitions": {
    "args": {
      "$id": "UserArgs",
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "minLength": 0,
              "type": "string"
            },
            "title": "[0]:usePresets",
            "description": ""
          }
        ]
      }
    }
  },
  "properties": {
    "publisher": {
      "default": "datanorden",
      "type": "string"
    },
    "parent": {
      "default": "devkit",
      "type": "string"
    },
    "name": {
      "default": "search",
      "type": "string"
    },
    "default": {
      "$id": "Defaults",

      "type": "object",
      "properties": {
        "args": {
          "$ref": "#/definitions/args"
        },
        "options": {
          "$id": "UserOptions",
          "default": {},
          "type": "object",
          "properties": {
            "dir": {
              "type": "string",
              "title": "-d, --dir <root>",
              "description": "dir: "
            },
            "path": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "title": "-p, --path <search...>",
              "description": "path: "
            },
            "name": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "title": "-n, --name <search...>",
              "description": "name: "
            },
            "content": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "title": "-c, --content <search...>",
              "description": "content: "
