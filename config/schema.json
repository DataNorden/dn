                    "type": "string"
                  },
                  "title": "-N, --skip-dirnames <search...>",
                  "description": "skipDirnames: "
                },
                "maxResults": {
                  "type": "string",
                  "title": "-m, --max-results <int>",
                  "description": "maxResults: "
                },
                "maxSize": {
                  "type": "string",
                  "title": "-s, --max-size <kB>",
                  "description": "maxSize: "
                },
                "outfile": {
                  "type": "string",
                  "title": "-o, --outfile <path>",
                  "description": "outfile: "
                },
                "ignoreCase": {
                  "type": "string",
                  "title": "-I, --no-ignore-case",
                  "description": "ignoreCase: "
                },
                "logLevel": {
                  "type": "string",
                  "title": "-L, --log-level <level>",
                  "description": "logLevel: "
                },
                "silent": {
                  "type": "boolean",
                  "title": "-S, --silent",
                  "description": "silent: "
